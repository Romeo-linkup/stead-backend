# Neon connection string, e.g. postgres://user:pass@host/db?sslmode=require
DATABASE_URL=

# any long random string
JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email settings (Phase 8)
EMAIL_ENABLED=false        # set to 'true' to enable sending
EMAIL_PROVIDER=resend      # 'resend' or 'brevo'
RESEND_API_KEY=            # required if EMAIL_PROVIDER=resend
BREVO_API_KEY=             # required if EMAIL_PROVIDER=brevo
EMAIL_FROM=Stead <no-reply@example.com>  # sender name and address
BACKEND_PUBLIC_URL=        # public URL of this API, used for unsubscribe links

# your deployed frontend URL, used for CORS
FRONTEND_URL=http://localhost:5173

NODE_ENV=development
PORT=4000

# Set to true to allow public owner account sign-up
SIGNUP_ENABLED=false
