# Neon connection string, e.g. postgres://user:pass@host/db?sslmode=require
DATABASE_URL=

# any long random string
JWT_SECRET=

# Platform admin authentication (separate from regular user JWT)
PLATFORM_JWT_SECRET=                # any long random string, different from JWT_SECRET
PLATFORM_TOTP_KEY=                  # 64 hex characters (32 bytes) for encrypting TOTP secrets
PLATFORM_ALLOWED_IPS=               # optional comma-separated list of allowed IPs for platform login
PLATFORM_ALLOW_NO_2FA=false         # should stay false in production once two-factor is set up

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email settings (Phase 8)
EMAIL_ENABLED=false        # set to 'true' to enable sending
EMAIL_PROVIDER=resend      # 'resend' or 'brevo'
RESEND_API_KEY=            # required if EMAIL_PROVIDER=resend
BREVO_API_KEY=             # required if EMAIL_PROVIDER=brevo
EMAIL_FROM=Stead <no-reply@example.com>  # sender name and address
BACKEND_PUBLIC_URL=        # public URL of this API, used for unsubscribe links

# your deployed frontend URL, used for CORS
FRONTEND_URL=http://localhost:5173

NODE_ENV=development
PORT=4000

# Set to true to allow public owner account sign-up
SIGNUP_ENABLED=false
